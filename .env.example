# --- Neon-managed values ---------------------------------------------------
# Written by `neon deploy` into .env.local. Do not hardcode these; run
# `neon deploy` (or `neon env pull`) on a fresh machine/branch instead.
DATABASE_URL=            # pooled connection string — application traffic
DATABASE_URL_UNPOOLED=   # direct connection — migrations only (drizzle-kit)
NEON_AUTH_BASE_URL=      # e.g. https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
NEON_AUTH_JWKS_URL=      # ${NEON_AUTH_BASE_URL}/.well-known/jwks.json
AWS_ACCESS_KEY_ID=       # Object Storage credentials (Neon injects these)
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=     # branch Object Storage endpoint
AWS_REGION=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# --- Scene HTML storage ----------------------------------------------------
# postgres = TEXT column on public_scenes (default, matches the spec)
# s3       = Neon Object Storage bucket; swap this file for Cloudflare R2 by
#            adding another SceneStorage implementation in src/storage.ts
SCENE_STORAGE=postgres
SCENE_BUCKET=assets

# --- Admin account (environment only, never a database row) -----------------
ADMIN_EMAIL=admin@example.com
# Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
# bcrypt hashes contain "$", which some .env loaders expand. Locally, quote the
# value: ADMIN_PASSWORD_HASH="$2a$12$...". Render's dashboard takes it as-is.
ADMIN_PASSWORD_HASH=
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Signs the 30-minute admin JWT only; it is
# deliberately unrelated to Neon Auth / Google sessions.
ADMIN_JWT_SECRET=

# Public origin used in docs/debugging. The OAuth relay derives the real origin
# from the incoming request, so this is optional.
PUBLIC_BASE_URL=http://localhost:8080
